{"id":11,"list":[{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["聲學路徑受身體影響："]},{"code":401,"indent":0,"parameters":["聲音從聲源到耳朵的路徑會受到聽者本身的頭部、耳殼、"]},{"code":401,"indent":0,"parameters":["軀幹的反射與繞射影響 。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["頭影效應 (Head Shadow)："]},{"code":401,"indent":0,"parameters":["對於頻率大於 1,500 Hz 的聲音（波長小於頭部直徑），"]},{"code":401,"indent":0,"parameters":["頭部會產生遮蔽作用，影響聲音傳遞 。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["方位角 (Azimuth)："]},{"code":401,"indent":0,"parameters":["描述聲源的水平方向。0° 為正前方，90° 為側邊（右側），"]},{"code":401,"indent":0,"parameters":["180° 為正後方 。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["仰角 (Elevation)："]},{"code":401,"indent":0,"parameters":["描述聲源的垂直方向。0° 為正前方，90° 為正上方 。"]},{"code":0,"indent":0,"parameters":[]}],"name":"閱讀筆記1","switchId":1,"trigger":0},
