{"id":13,"list":[{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["管狀共振結構："]},{"code":401,"indent":0,"parameters":["耳道被視為一端開放一端封閉（耳膜）的管狀結構，"]},{"code":401,"indent":0,"parameters":["具有共振特性 。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["耳道共振頻率計算："]},{"code":401,"indent":0,"parameters":["公式為 f=c/4L "]},{"code":401,"indent":0,"parameters":["耳道長約 2.3 cm，"]},{"code":401,"indent":0,"parameters":["共振峰值約落在 2,500 Hz 至 3,800 Hz 之間 。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["音量增益："]},{"code":401,"indent":0,"parameters":["透過耳道共振，耳膜處的音量相較於外部聲源可提高..."]},{"code":401,"indent":0,"parameters":["約 15 dB 。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["阻尼效應 (Damping)："]},{"code":401,"indent":0,"parameters":["耳膜與耳道壁具有吸收性，會產生阻尼，使共振峰變得寬廣"]},{"code":401,"indent":0,"parameters":["（約 2,000-5,000 Hz）而非單一尖峰 。"]},{"code":0,"indent":0,"parameters":[]}],"name":"閱讀筆記3","switchId":1,"trigger":0},
{"id":14,"list":[{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["頭部相關轉換函數(HRTF)："]},{"code":401,"indent":0,"parameters":["是指聲音從特定方向（如喇叭）發出後，經過整個路徑.."]},{"code":401,"indent":0,"parameters":["抵達耳膜所受到的綜合影響 。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["方向依賴性："]},{"code":401,"indent":0,"parameters":["HRTF 會隨聲源方向改變。"]},{"code":401,"indent":0,"parameters":["若聲源在 0°（正前方），兩耳 HRTF 相同；"]},{"code":401,"indent":0,"parameters":["若在 45°，近耳與遠耳的 HRTF 會產生顯著差異 。"]},{"code":0,"indent":0,"parameters":[]}],"name":"閱讀筆記4","switchId":1,"trigger":0},
{"id":15,"list":[{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["阻抗（Impedance）的物理本質："]},{"code":401,"indent":0,"parameters":["阻抗包含質量（Mass）、摩擦力（Friction）與彈力"]},{"code":401,"indent":0,"parameters":["（Stiffness）。空氣分子的移動非常容易（低阻抗），"]},{"code":401,"indent":0,"parameters":["但耳蝸內的液體分子移動阻力極大（高阻抗）。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["能量損失："]},{"code":401,"indent":0,"parameters":["空氣與水的阻抗比約為 4000：1。"]},{"code":401,"indent":0,"parameters":["若聲音直接由空氣撞擊耳蝸液體，約 99.9% 的聲能會被反射"]},{"code":401,"indent":0,"parameters":["（如(在水池外聽不到水底的細語）。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["換算成聲壓級，損失約為 35-40 dB。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["中耳角色："]},{"code":401,"indent":0,"parameters":["中耳可將這損失的 40 dB 「補回來」，"]},{"code":401,"indent":0,"parameters":["它扮演一個阻抗匹配變壓器的角色。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["中耳系統作為阻抗匹配變壓器， 可使聲音能量有效地從"]},{"code":401,"indent":0,"parameters":["空氣傳導到耳蝸。最有效的方法就是”提高”聲能能量，以"]},{"code":401,"indent":0,"parameters":["克服空氣和耳蝸液體之間的阻抗不匹配。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["中耳有三個機制來達成提高聲音能量："]},{"code":401,"indent":0,"parameters":["1. 面積比(area ratio) "]},{"code":401,"indent":0,"parameters":["2. 耳膜彎曲機制(curved-membrane mechanism) "]},{"code":401,"indent":0,"parameters":["3. 聽小骨鍊的槓桿原理(ossicular lever)"]},{"code":0,"indent":0,"parameters":[]}],"name":"閱讀筆記5","switchId":1,"trigger":0},
{"id":16,"list":[{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["面積比(area ratio)："]},{"code":401,"indent":0,"parameters":["當相同的力從大面積匯集到小面積時，壓力會提高 。"]},{"code":401,"indent":0,"parameters":["耳膜（Tympanic Membrane） 的有效振動面積約為 55 mm2"]},{"code":401,"indent":0,"parameters":["鐙骨足板（Stapes Footplate） 的面積僅約 3.2 mm2"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["面積比公式與增益："]},{"code":401,"indent":0,"parameters":["•壓力（P）= 力（F）/ 面積（A）"]},{"code":401,"indent":0,"parameters":["•面積比約為 17：1"]},{"code":401,"indent":0,"parameters":["•壓力會提高 17 倍，會提高25 dB"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["耳膜彎曲機制(curved-membrane mechanism)："]},{"code":401,"indent":0,"parameters":["耳膜的彎曲構造使得其在振動時，邊緣的位移較小，但能將"]},{"code":401,"indent":0,"parameters":["力量更集中地傳遞到鎚骨柄。這種構造使得傳遞到聽小骨的"]},{"code":401,"indent":0,"parameters":["「力」增加，而「位移」減小。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["耳膜彎曲機制提供了約 2 倍 的壓力增益，約為 6 dB。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["聽小骨鍊的槓桿原理(ossicular lever)："]},{"code":401,"indent":0,"parameters":["由於鎚骨比砧骨長，形成了一個「省力槓桿」"]},{"code":401,"indent":0,"parameters":["槓桿比約為 1.3：1"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["聽小骨鍊的槓桿原理(ossicular lever)："]},{"code":401,"indent":0,"parameters":["由於鎚骨比砧骨長，形成了一個「省力槓桿」"]},{"code":401,"indent":0,"parameters":["槓桿比約為 1.3：1"]},{"code":401,"indent":0,"parameters":["提供了約 1.3 倍的增益，換算後約為 2.2 dB。"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["中耳三種增益機制："]},{"code":401,"indent":0,"parameters":["面積比(17倍) 槓桿(1.3倍)、彎曲(2倍) .."]},{"code":401,"indent":0,"parameters":["總計產生 44 倍的壓力增益，"]},{"code":401,"indent":0,"parameters":["共約補回 33-35 dB 的能量損失。"]},{"code":0,"indent":0,"parameters":[]}],"name":"閱讀筆記6","switchId":1,"trigger":0},
{"id":17,"list":[{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["耳殼是將聲音匯入耳道並增強聲源定位。"]},{"code":401,"indent":0,"parameters":["聲音收集/漏斗功能對於人耳不是很重要。"]},{"code":401,"indent":0,"parameters":["耳殼對聽覺的最大貢獻是..."]},{"code":401,"indent":0,"parameters":["『聲源定位(sound source localization)』"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["耳殼會影響聲源定位，因為耳殼的凹陷和隆起會以某種方式"]},{"code":401,"indent":0,"parameters":["對訊號的高頻部分(大約4,000 Hz以上)進行濾波。"]},{"code":401,"indent":0,"parameters":["從耳殼進入的聲音頻譜變化(spectral variations)是..."]},{"code":401,"indent":0,"parameters":["重要的方向提示"]},{"code":101,"indent":0,"parameters":["",0,1,1]},{"code":401,"indent":0,"parameters":["當一隻耳朵(單耳)聆聽時，耳殼效應在聲源定位特別重要。"]},{"code":0,"indent":0,"parameters":[]}],"name":"閱讀筆記7","switchId":1,"trigger":0},
